{
  "name": "lab21",
  "version": "1.0.0",
  "description": "REST API для системы управления клиникой",
  "main": "server.js",
  "scripts": {
    "predev": "kill-port 3000",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "mail:check": "node scripts/checkMail.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "mongo:seed": "node scripts/seedMongo.js",
    "doctors:accounts": "node scripts/createDoctorAccounts.js",
    "admin:create": "node scripts/createAdmin.js",
    "auth:check": "node scripts/authCheck.js",
    "records:sync": "node scripts/syncVisitsToRecords.js",
    "patients:seed": "node scripts/seedPatients.js",
    "patients:reset": "node scripts/seedPatients.js --reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "docx": "^9.15.2",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "nodemailer": "^10.0.15",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
