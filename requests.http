########## Записи на приём ##########

###
GET {{host}}/appointments

###
GET {{host}}/appointments/1

### 404
GET {{host}}/appointments/999

### QUERY — как GET, но критерии поиска в теле запроса
QUERY {{host}}/appointments
Content-Type: application/json

{
  "status": "scheduled",
  "doctorId": 1
}

###
POST {{host}}/appointments
Content-Type: application/json

{
  "patientId": 4,
  "doctorId": 3,
  "date": "25-09-2026",
  "time": "11:30",
  "durationMinutes": 30,
  "reason": "Консультация",
  "cabinet": "312"
}

### 409 (врач уже занят на это время)
POST {{host}}/appointments
Content-Type: application/json

{
  "patientId": 2,
  "doctorId": 1,
  "date": "22-09-2026",
  "time": "09:30"
}

### 400 (ошибки валидации)
POST {{host}}/appointments
Content-Type: application/json

{
  "patientId": 999,
  "date": "31-02-2026",
  "time": "25:00"
}

###
PUT {{host}}/appointments/12
Content-Type: application/json

{
  "patientId": 4,
  "doctorId": 3,
  "date": "26-09-2026",
  "time": "15:30",
  "reason": "Плановый осмотр",
  "status": "scheduled",
  "cabinet": "312"
}

### 404
PUT {{host}}/appointments/999
Content-Type: application/json

{
  "patientId": 4,
  "doctorId": 3,
  "date": "26-09-2026",
  "time": "15:30"
}

###
PATCH {{host}}/appointments/12
Content-Type: application/json

{
  "status": "completed"
}

